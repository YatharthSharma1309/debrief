APP_NAME=Debrief
DEBUG=true
API_PREFIX=/api

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contextai

# Free OpenRouter path (preferred). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openrouter/free
LLM_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIMENSIONS=2048

# Optional fallback alias (same key format works with OpenRouter base URL)
# OPENAI_API_KEY=

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

RAG_TOP_K=5
RAG_MIN_SCORE=0.15
CHAT_HISTORY_LIMIT=10
